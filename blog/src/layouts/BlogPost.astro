---
import Base from './Base.astro';
import Cta from '../components/Cta.astro';
import { SITE, SITE_URL } from '../consts';

interface RelatedPost {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  keywords?: string[];
  heroImage?: string;
  faq?: { question: string; answer: string }[];
  relatedPosts?: RelatedPost[];
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  keywords = [],
  heroImage,
  faq = [],
  relatedPosts = [],
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = new URL(heroImage ?? SITE.defaultOgImage, Astro.site).toString();

const isoPub = pubDate.toISOString();
const isoUpd = (updatedDate ?? pubDate).toISOString();

const dateLabel = new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
}).format(pubDate);

// ---------- Structured data (JSON-LD) ----------
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: imageURL,
  datePublished: isoPub,
  dateModified: isoUpd,
  author: { '@type': 'Organization', name: SITE.author, url: SITE_URL },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    logo: { '@type': 'ImageObject', url: new URL('/favicon.ico', Astro.site).toString() },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  keywords: keywords.join(', '),
  inLanguage: 'pt-BR',
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};

const faqLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;
---

<Base
  title={`${title} | ${SITE.name}`}
  description={description}
  type="article"
  image={heroImage}
  keywords={keywords}
  publishedTime={isoPub}
  modifiedTime={isoUpd}
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(blogPostingLd)}
  />
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(breadcrumbLd)}
  />
  {faqLd && (
    <script
      type="application/ld+json"
      slot="head"
      set:html={JSON.stringify(faqLd)}
    />
  )}

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Início</a> › <a href="/blog">Blog</a> › <span>{title}</span>
  </nav>

  <article>
    <header class="article-header">
      <div class="post-meta">
        <time datetime={isoPub}>{dateLabel}</time>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
    </header>

    <div class="prose">
      <slot />
    </div>

    {faq.length > 0 && (
      <section class="faq" aria-label="Perguntas frequentes">
        <h2>Perguntas frequentes</h2>
        {faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
    )}

    <Cta />

    {relatedPosts.length > 0 && (
      <section class="related" aria-label="Leia também">
        <h2>Leia também</h2>
        <ul>
          {relatedPosts.map((p) => (
            <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
